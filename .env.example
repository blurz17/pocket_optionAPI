# ==============================================================================
# POCKET OPTION MARKET DATA HARVESTER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit your actual .env file with live secrets to Git.
# ==============================================================================

# Database Configuration (Neon PostgreSQL pooled connection URL)
DATABASE_URL=postgresql://user:password@ep-example-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
USE_SQLITE_FALLBACK=false
SQLITE_DB_PATH=pocket_option_candles.db

# Telegram Alert Configuration
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi
TELEGRAM_CHAT_ID=1234567890
TELEGRAM_ENABLED=true

# Pocket Option Session & Credentials
PO_SESSION=a:4:{s:10:"session_id";s:32:"example_session_id";s:10:"ip_address";s:13:"0.0.0.0";s:10:"user_agent";s:111:"Mozilla/5.0";s:13:"last_activity";i:0;}example_hash
PO_UID=142286757
PO_IS_DEMO=0
PO_PLATFORM=2

# Collection Defaults
DEFAULT_TIMEFRAME=60
DEFAULT_SYMBOLS=EURUSD_otc,GBPUSD_otc,USDJPY_otc,EURUSD

# Web Dashboard Server (In Heroku, PORT is dynamically set automatically)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
